.charts { color: #374151; padding: 8rpx 0; }
.chart-title { font-size: 30rpx; font-weight: 600; margin-top: 24rpx; }
.chart-canvas { height: 240px; width: 100%; }
ec-canvas { width: 100%; height: 100%; }
.chart-line { display: flex; justify-content: space-between; gap: 16rpx; padding: 12rpx 0; font-size: 26rpx; }
.chart-hint, .chart-error { font-size: 24rpx; color: #6B7280; margin-top: 20rpx; }
.daily-list { max-height: 240px; overflow-y: auto; }
.charts.dark { color: #E2E8F0; }
.charts.dark .chart-hint, .charts.dark .chart-error { color: #94A3B8; }
