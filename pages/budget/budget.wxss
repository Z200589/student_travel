.overview-card {
  background: linear-gradient(135deg, #07C160, #06AD56);
  color: #FFFFFF;
  border-radius: var(--radius-xl);
}

.overview-main {
  text-align: center;
  margin-bottom: var(--spacing-md);
}

.overview-label {
  font-size: var(--font-sm);
  opacity: 0.8;
}

.overview-total {
  font-size: 80rpx;
  font-weight: 700;
  display: block;
}

.overview-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: var(--spacing-md);
}

.overview-item {
  display: flex;
  flex-direction: column;
}

.overview-item.right {
  align-items: flex-end;
}

.overview-sub-label {
  font-size: var(--font-xs);
  opacity: 0.7;
}

.overview-sub-amount {
  font-size: var(--font-xl);
  font-weight: 600;
}

.overview-sub-amount.positive {
  color: #FFFFFF;
}

.overview-sub-amount.negative {
  color: #FFD700;
}

.progress-bar {
  height: 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: var(--spacing-xs);
}

.progress-fill {
  height: 100%;
  border-radius: 10rpx;
  transition: width 0.5s ease;
}

.progress-fill.safe {
  background: #52c41a;
}

.progress-fill.warning {
  background: #FAAD14;
}

.progress-fill.danger {
  background: #FF4D4F;
}

.progress-text {
  font-size: var(--font-xs);
  opacity: 0.7;
  text-align: center;
  display: block;
}

.daily-avg {
  text-align: center;
  margin-top: var(--spacing-sm);
  opacity: 0.8;
}

.category-list {
  padding: 0;
}

.category-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cat-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.cat-icon {
  font-size: 40rpx;
  margin-right: var(--spacing-md);
}

.cat-info {
  flex: 1;
}

.cat-name {
  font-size: var(--font-md);
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 6rpx;
}

.cat-bar-wrap {
  height: 8rpx;
  background: var(--bg-primary);
  border-radius: 4rpx;
  overflow: hidden;
}

.cat-bar {
  height: 100%;
  background: var(--brand-primary);
  border-radius: 4rpx;
  transition: width 0.5s ease;
}

.cat-right {
  text-align: right;
  margin-left: var(--spacing-md);
}

.cat-amount {
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--text-primary);
  display: block;
}

.cat-percent {
  font-size: var(--font-xs);
  color: var(--text-hint);
}

.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #07C160, #06AD56);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.4);
  z-index: 100;
}

.fab-icon {
  font-size: 48rpx;
  font-weight: 700;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.modal-content {
  background: var(--bg-card);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  padding: var(--spacing-lg);
  width: 100%;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-lg);
}

.modal-title {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-primary);
}

.modal-close {
  font-size: var(--font-xl);
  color: var(--text-hint);
  padding: var(--spacing-sm);
}

.modal-label {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: var(--spacing-sm);
  display: block;
}

.category-pills {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-lg);
}

.cat-pill {
  padding: 12rpx 24rpx;
  border-radius: 40rpx;
  font-size: var(--font-sm);
  background: var(--bg-primary);
  color: var(--text-secondary);
  border: 2rpx solid transparent;
}

.cat-pill.active {
  background: var(--brand-primary-light);
  color: var(--brand-primary);
  border-color: var(--brand-primary);
  font-weight: 600;
}

.modal-input {
  width: 100%;
  padding: var(--spacing-md);
  border-radius: var(--radius-md);
  background: var(--bg-primary);
  font-size: var(--font-md);
  color: var(--text-primary);
  margin-bottom: var(--spacing-md);
  box-sizing: border-box;
}

.picker-display {
  display: flex;
  align-items: center;
}

/* Phone layout and touch targets */
.fab-btn { min-width: 48px; min-height: 48px; right: 24rpx; bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.page, .container { padding-bottom: calc(144rpx + env(safe-area-inset-bottom)); }

.modal-content { box-sizing: border-box; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
