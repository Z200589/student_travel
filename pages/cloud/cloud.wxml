<view class="container {{isDarkMode ? 'dark' : ''}}">
<view class="card"><view class="title">一起规划，同步安排</view><view class="hint">上传本地旅行副本，邀请同行人共同查看和编辑。这里的修改保存在后台；副本包含本次旅行的账单、AA 成员与结算、清单和日记文本；本机原旅行保持独立。日记图片文件不上传。</view>
<input class="field" value="{{baseUrl}}" data-field="baseUrl" bindinput="onInput" disabled="{{busy}}" placeholder="协作后台地址"/><button bindtap="onConnect" disabled="{{busy}}">连接后台</button>
<button wx:if="{{!userId}}" bindtap="onLogin" disabled="{{busy}}">微信登录</button><view wx:else class="hint">已登录 · {{userId}}</view><button wx:if="{{userId}}" bindtap="onLogout" disabled="{{busy}}">退出协作账号</button>
<view wx:if="{{devEnabled}}"><view class="hint">本机联调账号，供开发者工具验证权限</view><view class="actions"><button data-account="student-a" bindtap="onDevLogin" disabled="{{busy}}">同学 A</button><button data-account="student-b" bindtap="onDevLogin" disabled="{{busy}}">同学 B</button><button data-account="student-c" bindtap="onDevLogin" disabled="{{busy}}">同学 C</button></view></view></view>
<view class="error card" wx:if="{{error}}">{{error}}</view>
<block wx:if="{{userId}}"><view class="card"><view class="title">上传本地旅行</view><picker range="{{localTrips}}" range-key="destination" value="{{localIndex}}" bindchange="onLocal"><view class="field">{{localTrips.length ? localTrips[localIndex].destination : '暂无本地旅行'}}　⌄</view></picker><button bindtap="onUpload" disabled="{{busy || !localTrips.length}}">☁ 上传旅行副本</button></view>
<view class="card"><view class="title">我的协作旅行</view><button bindtap="onRefresh" disabled="{{busy}}">↻ 刷新后台数据</button><view class="row" wx:for="{{trips}}" wx:key="id"><text>{{item.destination}} · {{item.role}} · 第 {{item.version}} 版</text><button data-id="{{item.id}}" bindtap="onOpen" disabled="{{busy}}">打开</button></view><view class="hint" wx:if="{{!trips.length}}">上传旅行，或使用邀请加入。</view></view>
<view class="card"><view class="title">加入同行人的旅行</view><input class="field" value="{{inviteToken}}" data-field="inviteToken" bindinput="onInput" placeholder="粘贴邀请口令" maxlength="100"/><button bindtap="onJoin" disabled="{{busy || !inviteToken}}">使用口令加入</button></view>
<view class="card" wx:if="{{current}}"><view class="title">{{current.payload.trip.destination}} · 协作副本</view><view class="hint">{{current.payload.trip.startDate}} — {{current.payload.trip.endDate}} · 第 {{current.version}} 版 · {{current.role === 'viewer' ? '只读权限' : '可编辑活动名称'}} · 修改后同行人点击刷新即可看到</view>
<view class="row" wx:for="{{activities}}" wx:key="index"><view>{{item.date}} {{item.time}}<view class="title-sm">{{item.name}}</view></view><button wx:if="{{current.role !== 'viewer'}}" data-index="{{index}}" bindtap="onEditActivity" disabled="{{busy}}">✎ 编辑</button></view><view class="hint" wx:if="{{!activities.length}}">当前没有活动</view>
<button bindtap="onManage" disabled="{{busy}}">📒 日程与 AA 账本</button><view class="title mt">共享账单</view><view wx:for="{{expenses}}" wx:key="id" class="hint">{{item.date}} · {{item.description}} · ¥{{item.amount}}{{item.split ? ' · AA 消费' : ''}}</view><view class="hint">在下方“日程与 AA 账本”中编辑、结算；后台数据暂不写回本机。</view>
<view class="title mt">协作成员</view><view class="row" wx:for="{{members}}" wx:key="userId"><text>{{item.label}} · {{item.role}}</text><button wx:if="{{current.role === 'owner' && item.role !== 'owner'}}" data-id="{{item.userId}}" bindtap="onMemberRole" disabled="{{busy}}">权限</button></view>
<block wx:if="{{current.role === 'owner'}}"><picker range="{{inviteRoles}}" value="{{inviteRoleIndex}}" bindchange="onRole"><view class="field">邀请权限：{{inviteRoles[inviteRoleIndex]}}　⌄</view></picker><button bindtap="onInvite" disabled="{{busy}}">生成 24 小时邀请</button><button bindtap="onCopyInvite" disabled="{{busy || !inviteToken}}">复制邀请口令</button><button open-type="share" disabled="{{busy || !canShare}}">微信分享邀请</button><button bindtap="onRevoke" disabled="{{busy}}">撤销本次邀请</button></block></view></block>
</view>