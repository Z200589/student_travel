.container{padding:24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));box-sizing:border-box;min-height:100vh}.card{padding:28rpx;margin-bottom:24rpx;border-radius:24rpx}.title{font-size:34rpx;font-weight:600}.title-sm{font-size:28rpx;font-weight:600;margin-top:12rpx}.hint{font-size:26rpx;line-height:1.7;color:var(--text-secondary);margin:20rpx 0;overflow-wrap:anywhere}.field{background:var(--bg-primary);color:var(--text-primary);height:96rpx;line-height:96rpx;padding:0 20rpx;border-radius:16rpx;margin-top:20rpx;font-size:26rpx;box-sizing:border-box;width:100%}button{border-radius:32rpx;min-height:44px;font-size:26rpx;color:var(--text-primary);background:var(--brand-primary-light);margin-top:20rpx}.actions{display:flex;gap:12rpx}.actions button{flex:1;padding:0 12rpx}.row{display:flex;gap:20rpx;justify-content:space-between;align-items:center;border-top:1rpx solid var(--border-color);padding:20rpx 0;overflow-wrap:anywhere}.row>view,.row>text{min-width:0;flex:1}.row button{flex-shrink:0;margin:0;font-size:24rpx}.error{color:#b53939;line-height:1.7}.mt{margin-top:36rpx}