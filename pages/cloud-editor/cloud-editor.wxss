.container{padding:24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));box-sizing:border-box;overflow-wrap:anywhere}.card{padding:28rpx;margin:24rpx 0;border-radius:24rpx}.title{font-size:32rpx;font-weight:600;line-height:1.5}.title-sm{font-size:28rpx;font-weight:600}.hint{font-size:26rpx;color:var(--text-secondary);line-height:1.7;margin:16rpx 0}.field{width:100%;box-sizing:border-box;min-height:48px;height:96rpx;padding:20rpx;margin:16rpx 0;border-radius:16rpx;font-size:28rpx;color:var(--text-primary);background:var(--bg-primary)}.notes{height:200rpx}.actions{display:flex;flex-wrap:wrap;gap:12rpx;align-items:center}.actions>input{flex:1;min-width:120rpx}.actions button{margin:0;flex:1;min-width:72rpx;padding:0 16rpx;font-size:24rpx}.row{border-top:1rpx solid var(--border-color);padding:24rpx 0}button{min-height:44px;border-radius:28rpx;background:var(--brand-primary-light);color:var(--text-primary);font-size:28rpx;margin-top:20rpx}.participants{display:flex;flex-wrap:wrap;gap:12rpx}.participants label{min-height:44px;display:flex;align-items:center;padding:8rpx 12rpx}.error{color:#b53939;line-height:1.7}