<view class="container {{isDarkMode ? 'dark' : ''}}"><view class="card error" wx:if="{{error}}">{{error}}</view><button bindtap="onRefresh" disabled="{{busy}}">↻ 刷新协作数据</button><block wx:if="{{current}}">
<view class="card"><view class="title">{{current.payload.trip.destination}} · 第 {{current.version}} 版</view><view class="hint">{{current.role === 'viewer' ? '只读成员' : '可编辑成员'}} · 修改保存到后台，同行人刷新后可见</view><view class="title">总支出 ¥{{total}} · AA 消费 ¥{{shared}}</view></view>
<view class="card" wx:for="{{days}}" wx:for-item="day" wx:for-index="di" wx:key="id"><view class="title">{{day.date}} · {{day.title}}</view><view class="row" wx:for="{{day.activities}}" wx:key="id"><view class="title-sm">{{item.time}} {{item.name}}</view><view class="hint" wx:if="{{item.notes}}">{{item.notes}}</view><view class="actions" wx:if="{{current.role !== 'viewer'}}"><button data-day="{{di}}" data-id="{{item.id}}" bindtap="onActivityEdit" disabled="{{busy}}">✎ 编辑</button><button data-day="{{di}}" data-id="{{item.id}}" data-delta="-1" bindtap="onMove" disabled="{{busy || !item.canUp}}">↑</button><button data-day="{{di}}" data-id="{{item.id}}" data-delta="1" bindtap="onMove" disabled="{{busy || !item.canDown}}">↓</button><button data-day="{{di}}" data-id="{{item.id}}" bindtap="onActivityDelete" disabled="{{busy}}">删除</button></view></view><view wx:if="{{!day.activities.length}}" class="hint">当天尚无活动</view><button wx:if="{{current.role !== 'viewer'}}" data-day="{{di}}" bindtap="onActivityAdd" disabled="{{busy}}">＋ 添加活动</button></view>
<view id="activity-form" class="card" wx:if="{{showActivity && current.role !== 'viewer'}}"><view class="title">{{activityId ? '编辑活动' : '添加活动'}} · {{days[dayIndex].date}}</view><input class="field" data-field="activityName" bindinput="onInput" value="{{activityName}}" maxlength="200" placeholder="真实地点或活动名称"/><picker mode="time" value="{{activityTime}}" bindchange="onActivityTime"><view class="field">时间：{{activityTime}}</view></picker><textarea class="field notes" data-field="activityNotes" bindinput="onInput" value="{{activityNotes}}" maxlength="1000" placeholder="活动备注"/><view class="actions"><button bindtap="onSaveActivity" disabled="{{busy}}">保存活动</button><button bindtap="onCancelActivity" disabled="{{busy}}">取消</button></view></view>
<view class="card"><view class="title">AA 同行成员</view><view class="hint">AA 成员为记账身份，与登录账号、协作权限独立。</view><view class="actions" wx:if="{{current.role !== 'viewer'}}"><input class="field" data-field="memberName" bindinput="onInput" value="{{memberName}}" maxlength="20" placeholder="成员称呼"/><button bindtap="onAddMember" disabled="{{busy}}">添加</button></view><view class="row" wx:for="{{aaMembers}}" wx:key="id"><view class="title-sm">{{item.name}} · {{item.balance}}</view><view class="hint">已付 ¥{{item.paid}} · 应摊 ¥{{item.share}}</view><view class="actions" wx:if="{{current.role !== 'viewer'}}"><button data-id="{{item.id}}" bindtap="onRename" disabled="{{busy}}">✎ 改名</button><button data-id="{{item.id}}" bindtap="onRemoveMember" disabled="{{busy}}">删除</button></view></view></view>
<view id="expense-form" class="card" wx:if="{{current.role !== 'viewer'}}"><view class="title">{{expenseId ? '编辑账单' : '新增账单'}}</view><picker range="{{types}}" value="{{typeIndex}}" bindchange="onType" disabled="{{!!expenseId}}"><view class="field">{{types[typeIndex]}}　⌄</view></picker><input class="field" data-field="amount" bindinput="onInput" value="{{amount}}" type="digit" maxlength="12" placeholder="金额（元）"/><input class="field" data-field="description" bindinput="onInput" value="{{description}}" maxlength="100" placeholder="消费说明"/><picker range="{{categories}}" range-key="label" value="{{categoryIndex}}" bindchange="onCategory"><view class="field">分类：{{categories[categoryIndex].label}}</view></picker><picker mode="date" value="{{date || current.payload.trip.startDate}}" bindchange="onDate"><view class="field">日期：{{date || current.payload.trip.startDate}}</view></picker>
<block wx:if="{{typeIndex === 1}}"><picker range="{{aaMembers}}" range-key="name" value="{{payerIndex}}" bindchange="onPayer"><view class="field">付款人：{{payerId ? aaMembers[payerIndex].name : '请选择付款人'}}</view></picker><view class="hint">选择参与平摊成员，付款人可不参与</view><checkbox-group bindchange="onParticipants" class="participants"><label wx:for="{{aaMembers}}" wx:key="id"><checkbox value="{{item.id}}" checked="{{item.selected}}"/><text>{{item.name}}</text></label></checkbox-group><view class="hint" wx:for="{{preview}}" wx:key="name">{{item.name}} 分摊 ¥{{item.amount}}</view></block><view class="hint" wx:if="{{expenseId}}">编辑会重算预算及分摊，已记录的线下转账保留。</view><button bindtap="onSaveExpense" disabled="{{busy}}" loading="{{busy}}">保存并同步账单</button><button wx:if="{{expenseId}}" bindtap="onCancelExpense" disabled="{{busy}}">取消编辑</button></view>
<view class="card"><view class="title">消费明细</view><view class="row" wx:for="{{expenses}}" wx:key="id"><view class="title-sm">{{item.description}} · ¥{{item.amountText}}</view><view class="hint">{{item.date}} · {{item.shareText}}</view><view class="actions" wx:if="{{current.role !== 'viewer'}}"><button data-id="{{item.id}}" bindtap="onEditExpense" disabled="{{busy}}">✎ 编辑</button><button data-id="{{item.id}}" bindtap="onDeleteExpense" disabled="{{busy}}">删除</button></view></view><view class="hint" wx:if="{{!expenses.length}}">暂无账单</view></view>
<view class="card"><view class="title">结算建议</view><view class="hint">请完成真实转账后再确认；这里只记账，不扣款。</view><view class="row" wx:for="{{suggestions}}" wx:key="index"><view>{{item.fromName}} → {{item.toName}} ¥{{item.amount}}</view><button wx:if="{{current.role !== 'viewer'}}" data-index="{{index}}" bindtap="onSettle" disabled="{{busy}}">已线下支付</button></view><view wx:if="{{!suggestions.length}}" class="hint">当前没有待结算金额</view></view>
<view class="card" wx:if="{{settlements.length}}"><view class="title">结算记录</view><view class="row" wx:for="{{settlements}}" wx:key="id"><view>{{item.fromName}} → {{item.toName}} ¥{{item.amount}}</view><button wx:if="{{current.role !== 'viewer'}}" data-id="{{item.id}}" bindtap="onUndo" disabled="{{busy}}">撤销记录</button></view></view>
</block></view>