.page-header {
  padding: var(--spacing-lg) var(--spacing-md) var(--spacing-md);
}

.page-title {
  font-size: var(--font-xxl);
  font-weight: 700;
  color: var(--text-primary);
  display: block;
}

.page-subtitle {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  margin-top: var(--spacing-xs);
  display: block;
}

.filter-scroll {
  white-space: nowrap;
  margin-bottom: var(--spacing-md);
}

.filter-tabs {
  display: flex;
  padding: 0 var(--spacing-md);
  gap: var(--spacing-sm);
}

.filter-tab {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  background: var(--bg-card);
  flex-shrink: 0;
  transition: all 0.3s ease;
}

.filter-tab.active {
  background: var(--brand-primary);
  color: #FFFFFF;
  font-weight: 600;
}

/* Timeline */
.timeline {
  padding: 0 var(--spacing-md);
}

.timeline-item {
  display: flex;
  flex-direction: row;
}

.timeline-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: var(--spacing-md);
  width: 60rpx;
}

.node-day {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--brand-primary);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sm);
  font-weight: 700;
  flex-shrink: 0;
}

.node-line {
  flex: 1;
  width: 4rpx;
  background: var(--border-color);
  margin-top: var(--spacing-xs);
}

.timeline-card {
  flex: 1;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: 0 2rpx 12rpx var(--shadow-color);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-sm);
}

.card-date {
  font-size: var(--font-xs);
  color: var(--text-hint);
}

.card-mood {
  font-size: 40rpx;
}

.card-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: var(--spacing-sm);
}

.card-content {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.8;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  margin-bottom: var(--spacing-md);
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-md);
}

.photo-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-sm);
}

.card-stats {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
}

.stat {
  font-size: var(--font-xs);
  color: var(--text-hint);
}

/* FAB */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #07C160, #06AD56);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.4);
  z-index: 100;
}

.fab-icon {
  font-size: 48rpx;
  font-weight: 700;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.modal-content {
  background: var(--bg-card);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  padding: var(--spacing-lg);
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-lg);
}

.modal-title {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-primary);
}

.modal-close {
  font-size: var(--font-xl);
  color: var(--text-hint);
  padding: var(--spacing-sm);
}

.modal-label {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: var(--spacing-sm);
  display: block;
}

.modal-input {
  width: 100%;
  padding: var(--spacing-md);
  border-radius: var(--radius-md);
  background: var(--bg-primary);
  font-size: var(--font-md);
  color: var(--text-primary);
  margin-bottom: var(--spacing-md);
  box-sizing: border-box;
}

.modal-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: var(--spacing-md);
  border-radius: var(--radius-md);
  background: var(--bg-primary);
  font-size: var(--font-md);
  color: var(--text-primary);
  margin-bottom: var(--spacing-md);
  box-sizing: border-box;
  line-height: 1.6;
}

.picker-display {
  display: flex;
  align-items: center;
}

.photo-upload {
  margin-bottom: var(--spacing-md);
}

.upload-placeholder {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-md);
  border: 2rpx dashed var(--border-color);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  font-size: 48rpx;
  margin-bottom: var(--spacing-xs);
}

.upload-text {
  font-size: var(--font-xs);
  color: var(--text-hint);
}

.emoji-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
}

.emoji-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-sm) var(--spacing-md);
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
  min-width: 80rpx;
}

.emoji-item.active {
  background: var(--brand-primary-light);
  border-color: var(--brand-primary);
}

.emoji {
  font-size: 44rpx;
  margin-bottom: 4rpx;
}

.emoji-label {
  font-size: var(--font-xs);
  color: var(--text-secondary);
}

.row-2col {
  display: flex;
  gap: var(--spacing-md);
}

.col-half {
  flex: 1;
}

/* Phone layout and touch targets */
.fab-btn { min-width: 48px; min-height: 48px; right: 24rpx; bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.page, .container { padding-bottom: calc(144rpx + env(safe-area-inset-bottom)); }

.modal-content { box-sizing: border-box; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
