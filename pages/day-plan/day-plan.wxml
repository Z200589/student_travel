<!--
  pages/day-plan/day-plan 每日行程详情页
  展示某一天的上午/下午/晚上行程、交通、花费、注意事项等
-->
<view class="page {{isDarkMode ? 'dark' : ''}}">
  <!-- ========== 顶部标题栏 ========== -->
  <view class="page-header gradient-header">
    <view class="day-info" wx:if="{{dayData}}">
      <view class="flex-row align-center" style="gap: 12rpx; margin-bottom: 8rpx;">
        <view class="day-index-badge flex-center">
          <text class="font-sm font-bold text-white">第{{dayIndex + 1}}天</text>
        </view>
        <text class="font-md text-white" style="opacity: 0.85;">{{dayData.date}} {{weekday}}</text>
      </view>
      <text class="font-xl font-bold text-white" style="display: block;">{{dayData.title || '今日行程'}}</text>
    </view>
  </view>

  <view class="day-scroll">
    <!-- ========== 上午行程 ========== -->
    <view class="section animate-fade-in">
      <view class="period-header flex-row align-center">
        <text class="period-icon">🌅</text>
        <text class="period-title font-lg font-bold text-primary">上午</text>
      </view>
      <view wx:if="{{morningActivities.length > 0}}">
        <view class="card activity-card" wx:for="{{morningActivities}}" wx:key="index" bindlongpress="onEditActivity" data-index="{{index}}" data-period="morning">
          <view class="flex-between align-start">
            <view style="flex: 1;">
              <view class="flex-row align-center" style="gap: 12rpx;">
                <text class="activity-time font-sm font-bold text-brand">{{item.time}}</text>
                <text class="font-md font-bold text-primary">{{item.name || item.activity}}</text>
              </view>
              <view class="font-sm text-secondary mt-xs" wx:if="{{item.location || item.desc}}">
                📍 {{item.location || item.desc}}
              </view>
              <view class="font-xs text-hint mt-xs" wx:if="{{item.note}}">
                💡 {{item.note}}
              </view>
            </view>
            <text class="activity-cost font-sm text-warning" wx:if="{{item.cost}}">¥{{item.cost}}</text>
          </view>
          <!-- 长按编辑按钮 -->
          <view class="edit-hint font-xs text-hint mt-sm">长按可编辑</view>
        </view>
      </view>
      <view wx:else class="card flex-center" style="padding: 32rpx;">
        <text class="text-hint font-sm">暂无上午行程安排</text>
      </view>
      <!-- 添加新活动按钮 -->
      <view class="add-activity-btn flex-center" bindtap="addActivity" data-period="morning">
        <text class="text-brand font-sm">+ 添加活动</text>
      </view>
    </view>

    <!-- ========== 下午行程 ========== -->
    <view class="section animate-fade-in">
      <view class="period-header flex-row align-center">
        <text class="period-icon">🌤</text>
        <text class="period-title font-lg font-bold text-primary">下午</text>
      </view>
      <view wx:if="{{afternoonActivities.length > 0}}">
        <view class="card activity-card" wx:for="{{afternoonActivities}}" wx:key="index" bindlongpress="onEditActivity" data-index="{{index}}" data-period="afternoon">
          <view class="flex-between align-start">
            <view style="flex: 1;">
              <view class="flex-row align-center" style="gap: 12rpx;">
                <text class="activity-time font-sm font-bold text-brand">{{item.time}}</text>
                <text class="font-md font-bold text-primary">{{item.name || item.activity}}</text>
              </view>
              <view class="font-sm text-secondary mt-xs" wx:if="{{item.location || item.desc}}">
                📍 {{item.location || item.desc}}
              </view>
              <view class="font-xs text-hint mt-xs" wx:if="{{item.note}}">
                💡 {{item.note}}
              </view>
            </view>
            <text class="activity-cost font-sm text-warning" wx:if="{{item.cost}}">¥{{item.cost}}</text>
          </view>
          <view class="edit-hint font-xs text-hint mt-sm">长按可编辑</view>
        </view>
      </view>
      <view wx:else class="card flex-center" style="padding: 32rpx;">
        <text class="text-hint font-sm">暂无下午行程安排</text>
      </view>
      <view class="add-activity-btn flex-center" bindtap="addActivity" data-period="afternoon">
        <text class="text-brand font-sm">+ 添加活动</text>
      </view>
    </view>

    <!-- ========== 晚上行程 ========== -->
    <view class="section animate-fade-in">
      <view class="period-header flex-row align-center">
        <text class="period-icon">🌙</text>
        <text class="period-title font-lg font-bold text-primary">晚上</text>
      </view>
      <view wx:if="{{eveningActivities.length > 0}}">
        <view class="card activity-card" wx:for="{{eveningActivities}}" wx:key="index" bindlongpress="onEditActivity" data-index="{{index}}" data-period="evening">
          <view class="flex-between align-start">
            <view style="flex: 1;">
              <view class="flex-row align-center" style="gap: 12rpx;">
                <text class="activity-time font-sm font-bold text-brand">{{item.time}}</text>
                <text class="font-md font-bold text-primary">{{item.name || item.activity}}</text>
              </view>
              <view class="font-sm text-secondary mt-xs" wx:if="{{item.location || item.desc}}">
                📍 {{item.location || item.desc}}
              </view>
              <view class="font-xs text-hint mt-xs" wx:if="{{item.note}}">
                💡 {{item.note}}
              </view>
            </view>
            <text class="activity-cost font-sm text-warning" wx:if="{{item.cost}}">¥{{item.cost}}</text>
          </view>
          <view class="edit-hint font-xs text-hint mt-sm">长按可编辑</view>
        </view>
      </view>
      <view wx:else class="card flex-center" style="padding: 32rpx;">
        <text class="text-hint font-sm">暂无晚上行程安排</text>
      </view>
      <view class="add-activity-btn flex-center" bindtap="addActivity" data-period="evening">
        <text class="text-brand font-sm">+ 添加活动</text>
      </view>
    </view>

    <!-- ========== 信息卡片 ========== -->
    <view class="section animate-fade-in">
      <view class="info-card card">
        <!-- 交通方式 -->
        <view class="info-row flex-row align-start" style="gap: 16rpx; margin-bottom: 24rpx;">
          <text class="info-emoji font-lg">🚗</text>
          <view>
            <text class="font-md font-bold text-primary" style="display: block;">交通方式</text>
            <text class="font-sm text-secondary mt-xs" style="display: block;">{{dayData.transport || '暂无安排'}}</text>
          </view>
        </view>

        <!-- 预计花费 -->
        <view class="info-row flex-row align-start" style="gap: 16rpx; margin-bottom: 24rpx;">
          <text class="info-emoji font-lg">💰</text>
          <view>
            <text class="font-md font-bold text-primary" style="display: block;">预计花费</text>
            <text class="font-sm text-secondary mt-xs" style="display: block;">
              {{dayData.estimatedCost ? '¥' + dayData.estimatedCost : '暂无预算'}}
            </text>
          </view>
        </view>

        <!-- 注意事项 -->
        <view class="info-row flex-row align-start" style="gap: 16rpx; margin-bottom: 24rpx;" wx:if="{{dayTips.length > 0}}">
          <text class="info-emoji font-lg">⚠️</text>
          <view>
            <text class="font-md font-bold text-primary" style="display: block;">注意事项</text>
            <view wx:for="{{dayTips}}" wx:key="index" class="font-sm text-secondary mt-xs" style="display: block;">
              • {{item}}
            </view>
          </view>
        </view>

        <!-- 备用计划 -->
        <view class="info-row flex-row align-start" style="gap: 16rpx;" wx:if="{{dayData.backupPlan}}">
          <text class="info-emoji font-lg">🔄</text>
          <view>
            <text class="font-md font-bold text-primary" style="display: block;">备用计划</text>
            <text class="font-sm text-secondary mt-xs" style="display: block;">{{dayData.backupPlan}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ========== 底部导航 ========== -->
    <view class="bottom-nav section" style="margin-top: 32rpx; margin-bottom: 60rpx;">
      <view class="nav-row flex-row" style="gap: 16rpx;">
        <view
          class="btn {{hasPrevDay ? 'btn-secondary' : ''}} flex-1"
          style="{{!hasPrevDay ? 'opacity: 0.3; pointer-events: none;' : ''}}"
          bindtap="goToPrevDay"
        >
          ‹ 上一天
        </view>
        <view class="btn btn-primary flex-1" bindtap="goBackToTrip">
          返回行程总览
        </view>
        <view
          class="btn {{hasNextDay ? 'btn-secondary' : ''}} flex-1"
          style="{{!hasNextDay ? 'opacity: 0.3; pointer-events: none;' : ''}}"
          bindtap="goToNextDay"
        >
          下一天 ›
        </view>
      </view>
    </view>
  </view>
</view>
