<!--
  pages/trips/trips 我的旅行
  Tab 页面，展示所有旅行计划，支持搜索和筛选
-->
<view class="page {{isDarkMode ? 'dark' : ''}}">
  <!-- ========== 顶部标题栏 ========== -->
  <view class="trips-header flex-between">
    <text class="font-xl font-bold text-primary">我的旅行</text>
    <view class="search-toggle" bindtap="toggleSearch">
      <text class="search-emoji">🔍</text>
    </view>
  </view>

  <!-- ========== 搜索栏 ========== -->
  <view class="search-section" wx:if="{{showSearch}}">
    <view class="search-bar">
      <text class="search-icon-emoji">🔍</text>
      <input
        class="search-input"
        placeholder="搜索目的地..."
        value="{{keyword}}"
        bindinput="onSearchInput"
        confirm-type="search"
        bindconfirm="doSearch"
      />
      <text class="search-clear" wx:if="{{keyword}}" bindtap="clearSearch">✕</text>
    </view>
  </view>

  <!-- ========== 筛选标签 ========== -->
  <view class="filter-section">
    <scroll-view scroll-x class="filter-scroll" enhanced show-scrollbar="{{false}}">
      <view class="filter-tabs flex-row">
        <view
          class="filter-tab {{activeFilter === item.value ? 'active' : ''}}"
          wx:for="{{filterTabs}}"
          wx:key="value"
          bindtap="onFilterTab"
          data-value="{{item.value}}"
        >
          <text>{{item.label}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- ========== 加载状态 ========== -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <loading-state />
  </view>

  <!-- ========== 旅行列表 ========== -->
  <view wx:elif="{{filteredTrips.length > 0}}" class="trip-list animate-fade-in">
    <trip-card
      wx:for="{{filteredTrips}}"
      wx:key="id"
      trip="{{item}}"
      data-id="{{item.id}}"
      bind:select="goToTripDetail"
    />
  </view>

  <!-- ========== 空状态 ========== -->
  <view wx:else class="empty-wrap animate-fade-in">
    <empty-state
      title="开始你的第一次旅行"
      description="点击下方按钮创建你的第一个旅行计划"
      icon="✈️"
    />
    <view class="btn btn-primary mt-lg" bindtap="goToCreate">开始创建</view>
  </view>

  <!-- ========== FAB 悬浮按钮 ========== -->
  <view class="fab-btn flex-center" bindtap="goToCreate">
    <image class="fab-symbol" src="/assets/icons/plus-white.png" mode="aspectFit" />
  </view>
</view>
