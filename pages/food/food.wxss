.page-header {
  padding: var(--spacing-lg) var(--spacing-md) var(--spacing-md);
}

.page-title {
  font-size: var(--font-xxl);
  font-weight: 700;
  color: var(--text-primary);
  display: block;
}

.page-subtitle {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  margin-top: var(--spacing-xs);
  display: block;
}

.filter-scroll {
  white-space: nowrap;
  margin-bottom: var(--spacing-md);
}

.filter-tabs {
  display: flex;
  padding: 0 var(--spacing-md);
  gap: var(--spacing-sm);
}

.filter-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 32rpx;
  border-radius: 40rpx;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  background: var(--bg-card);
  flex-shrink: 0;
  transition: all 0.3s ease;
}

.filter-tab.active {
  background: var(--brand-primary);
  color: #FFFFFF;
  font-weight: 600;
}

.food-list {
  padding: 0 var(--spacing-md);
}

/* Detail sheet */
.detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.detail-sheet {
  background: var(--bg-card);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
}

.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-lg);
  position: sticky;
  top: 0;
  background: var(--bg-card);
  z-index: 10;
}

.detail-title {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-primary);
}

.detail-close {
  font-size: var(--font-xl);
  color: var(--text-hint);
  padding: var(--spacing-sm);
}

.detail-image {
  width: 100%;
  height: 400rpx;
}

.detail-body {
  padding: var(--spacing-lg);
}

.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-sm);
}

.detail-name {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-primary);
}

.detail-meta {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-md);
}

.detail-price {
  font-size: var(--font-md);
  color: var(--brand-primary);
  font-weight: 600;
}

.rating {
  display: flex;
  align-items: center;
}

.star {
  color: #F59E0B;
  font-size: var(--font-sm);
  margin-right: 4rpx;
}

.rating-num {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  font-weight: 600;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-md);
}

.mini-tag {
  font-size: var(--font-xs);
  color: var(--text-hint);
  background: var(--bg-primary);
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.detail-section-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-top: var(--spacing-md);
  margin-bottom: var(--spacing-xs);
}

.detail-desc {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.8;
}

.detail-actions {
  display: flex;
  gap: var(--spacing-md);
}

.detail-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-md);
  border-radius: var(--radius-md);
  background: var(--bg-primary);
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-secondary);
}

.detail-btn.active-fav {
  background: #FEE2E2;
  color: var(--danger);
}

.detail-btn.active-eaten {
  background: var(--brand-primary-light);
  color: var(--brand-primary);
}

.detail-sheet { box-sizing: border-box; padding-bottom: env(safe-area-inset-bottom); }
.detail-close { min-width: 44px; min-height: 44px; box-sizing: border-box; text-align: center; }
.detail-title { min-width: 0; }
