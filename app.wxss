/* app.wxss - 全局样式 */

/* ========== CSS 变量 ========== */
page {
  /* 浅色主题 */
  --bg-primary: #F6F7FB;
  --bg-secondary: #FFFFFF;
  --bg-card: #FFFFFF;
  --text-primary: #1A1A2E;
  --text-secondary: #6B7280;
  --text-hint: #9CA3AF;
  --border-color: #E5E7EB;
  --shadow-color: rgba(0, 0, 0, 0.08);

  /* 品牌色 */
  --brand-primary: #07C160;
  --brand-primary-light: #E8F8EF;
  --brand-secondary: #3B82F6;
  --brand-accent: #F59E0B;

  /* 功能色 */
  --success: #10B981;
  --warning: #F59E0B;
  --danger: #EF4444;
  --info: #3B82F6;

  /* 间距 */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;

  /* 字体大小 */
  --font-xs: 20rpx;
  --font-sm: 24rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 36rpx;
  --font-xxl: 44rpx;
  --font-title: 52rpx;

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: var(--font-md);
  color: var(--text-primary);
  background-color: var(--bg-primary);
  line-height: 1.6;
}

/* ========== 暗黑模式 ========== */
page.dark, .page.dark, .container.dark {
  --bg-primary: #0F172A;
  --bg-secondary: #1E293B;
  --bg-card: #1E293B;
  --text-primary: #F1F5F9;
  --text-secondary: #94A3B8;
  --text-hint: #64748B;
  --border-color: #334155;
  --shadow-color: rgba(0, 0, 0, 0.3);

  --brand-primary-light: #064E3B;
}

/* ========== 基础样式 ========== */
.container {
  padding: var(--spacing-md);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ========== 卡片 ========== */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: 0 2rpx 12rpx var(--shadow-color);
  transition: all 0.3s ease;
}

.card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* ========== Flex 工具 ========== */
.flex { display: flex; }
.flex-row { display: flex; flex-direction: row; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-wrap { flex-wrap: wrap; }
.flex-1 { flex: 1; }
.align-start { align-items: flex-start; }
.align-center { align-items: center; }

/* ========== 间距 ========== */
.mt-xs { margin-top: var(--spacing-xs); }
.mt-sm { margin-top: var(--spacing-sm); }
.mt-md { margin-top: var(--spacing-md); }
.mt-lg { margin-top: var(--spacing-lg); }
.mt-xl { margin-top: var(--spacing-xl); }
.mb-xs { margin-bottom: var(--spacing-xs); }
.mb-sm { margin-bottom: var(--spacing-sm); }
.mb-md { margin-bottom: var(--spacing-md); }
.mb-lg { margin-bottom: var(--spacing-lg); }
.mb-xl { margin-bottom: var(--spacing-xl); }
.ml-xs { margin-left: var(--spacing-xs); }
.ml-sm { margin-left: var(--spacing-sm); }
.ml-md { margin-left: var(--spacing-md); }
.mr-xs { margin-right: var(--spacing-xs); }
.mr-sm { margin-right: var(--spacing-sm); }
.mr-md { margin-right: var(--spacing-md); }
.p-sm { padding: var(--spacing-sm); }
.p-md { padding: var(--spacing-md); }
.p-lg { padding: var(--spacing-lg); }

/* ========== 文字 ========== */
.text-primary { color: var(--text-primary); }
.text-secondary { color: var(--text-secondary); }
.text-hint { color: var(--text-hint); }
.text-brand { color: var(--brand-primary); }
.text-success { color: var(--success); }
.text-warning { color: var(--warning); }
.text-danger { color: var(--danger); }
.text-white { color: #FFFFFF; }

.font-xs { font-size: var(--font-xs); }
.font-sm { font-size: var(--font-sm); }
.font-md { font-size: var(--font-md); }
.font-lg { font-size: var(--font-lg); }
.font-xl { font-size: var(--font-xl); }
.font-xxl { font-size: var(--font-xxl); }
.font-title { font-size: var(--font-title); }

.font-bold { font-weight: 700; }
.font-medium { font-weight: 500; }
.text-center { text-align: center; }
.text-right { text-align: right; }
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ========== 按钮 ========== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-lg);
  padding: 20rpx 40rpx;
  font-size: var(--font-md);
  font-weight: 600;
  border: none;
  transition: all 0.3s ease;
}

.btn::after { border: none; }

.btn-primary {
  background: linear-gradient(135deg, #07C160, #06AD56);
  color: #FFFFFF;
}

.btn-primary:active {
  background: linear-gradient(135deg, #06AD56, #059A4A);
}

.btn-secondary {
  background: var(--brand-primary-light);
  color: var(--brand-primary);
}

.btn-outline {
  background: transparent;
  border: 2rpx solid var(--brand-primary);
  color: var(--brand-primary);
}

.btn-danger {
  background: linear-gradient(135deg, #EF4444, #DC2626);
  color: #FFFFFF;
}

.btn-block {
  display: flex;
  width: 100%;
}

.btn-sm {
  padding: 12rpx 24rpx;
  font-size: var(--font-sm);
  border-radius: var(--radius-md);
}

.btn-lg {
  padding: 28rpx 56rpx;
  font-size: var(--font-lg);
}

/* ========== 标签 ========== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: var(--font-xs);
  font-weight: 500;
}

.tag-green {
  background: var(--brand-primary-light);
  color: var(--brand-primary);
}

.tag-blue {
  background: #EBF5FF;
  color: var(--info);
}

.tag-yellow {
  background: #FEF3C7;
  color: #D97706;
}

.tag-red {
  background: #FEE2E2;
  color: var(--danger);
}

.tag-gray {
  background: #F3F4F6;
  color: #6B7280;
}

/* ========== 分割线 ========== */
.divider {
  height: 1rpx;
  background: var(--border-color);
  margin: var(--spacing-md) 0;
}

/* ========== 头部标题 ========== */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-md);
}

.section-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
}

.section-more {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

/* ========== 空状态 ========== */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx var(--spacing-lg);
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: var(--spacing-lg);
  opacity: 0.6;
}

.empty-text {
  font-size: var(--font-md);
  color: var(--text-hint);
}

/* ========== 加载 ========== */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx;
}

.loading-text {
  font-size: var(--font-sm);
  color: var(--text-hint);
  margin-top: var(--spacing-md);
}

/* ========== 搜索栏 ========== */
.search-bar {
  display: flex;
  align-items: center;
  background: var(--bg-secondary);
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  margin-bottom: var(--spacing-md);
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: var(--spacing-sm);
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: var(--font-md);
  color: var(--text-primary);
  background: transparent;
}

/* ========== 滚动条隐藏 ========== */
::-webkit-scrollbar {
  display: none;
}

/* ========== 渐变背景头部 ========== */
.gradient-header {
  background: linear-gradient(135deg, #07C160, #06AD56, #059A4A);
  padding: var(--spacing-xl) var(--spacing-lg) var(--spacing-lg);
  border-radius: 0 0 var(--radius-xl) var(--radius-xl);
  color: #FFFFFF;
}

/* ========== 动画 ========== */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.animate-fade-in {
  animation: fadeIn 0.4s ease-out;
}

.animate-slide-up {
  animation: slideUp 0.3s ease-out;
}

.animate-pulse {
  animation: pulse 2s infinite;
}

/* Phone layout and touch targets */

.page { width: 100%; overflow-wrap: break-word; }
.btn, .card, .input-wrap, .bottom-bar, .modal-content { box-sizing: border-box; }
.btn { min-height: 44px; gap: 12rpx; line-height: 1.4; text-align: center; }
.flex-1, .search-input, .activity-name { min-width: 0; }
.activity-name { flex: 1; }
.activity-time { flex-shrink: 0; }
.section-header { gap: 16rpx; }
.section-title { min-width: 0; }
.section-more { min-height: 44px; display: flex; align-items: center; flex-shrink: 0; }
.action-icon-disc { width: 88rpx; height: 88rpx; border-radius: 50%; background: #E8F8EF; display: flex; align-items: center; justify-content: center; margin-bottom: 12rpx; flex-shrink: 0; }
.action-icon { display: block; width: 52rpx; height: 52rpx; }
.button-icon { width: 40rpx; height: 40rpx; flex-shrink: 0; }
.fab-symbol { width: 48rpx; height: 48rpx; }
.modal-content { padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.modal-close { min-width: 44px; min-height: 44px; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
@media (max-width: 360px) {
  .font-xs { font-size: 12px; }
  .font-sm { font-size: 13px; }
  .btn { padding-left: 24rpx; padding-right: 24rpx; }
}


.filter-tab, .cat-pill { min-height: 44px; box-sizing: border-box; }
